---
---
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Custom Lab | CMYK Brand Media</title>
	</head>
	<body class="bg-[#0b0b0c] text-white font-sans antialiased pb-24">
		<header class="px-6 py-4 border-b border-white/10 sticky top-0 bg-[#0b0b0c]/80 backdrop-blur-md">
			<h1 class="text-sm font-bold uppercase tracking-wider text-cyan-400">The Custom Lab</h1>
		</header>
		<main class="max-w-md mx-auto px-4 pt-4 space-y-4">
			<div class="bg-neutral-900 border border-white/10 rounded-2xl p-4 space-y-3">
				<h2 class="text-xs font-bold uppercase tracking-wider text-neutral-300">Select Print Machinery</h2>
				<button class="w-full text-left p-3 bg-neutral-800/60 border border-white/5 rounded-xl text-xs font-medium">DTF Print (Direct-to-Film)</button>
				<button class="w-full text-left p-3 bg-neutral-800/60 border border-white/5 rounded-xl text-xs font-medium">UV Print (Hard Items)</button>
			</div>
		</main>
		<nav class="fixed bottom-0 left-0 right-0 bg-[#0b0b0c]/90 border-t border-white/10 py-3 px-6 z-50">
			<div class="max-w-md mx-auto flex justify-around text-xs">
				<a href="/" class="text-neutral-400">Home</a>
				<a href="/store" class="text-neutral-400">Store</a>
				<a href="/custom-lab" class="text-cyan-400 font-medium">Custom Lab</a>
				<a href="/profile" class="text-neutral-400">Profile</a>
			</div>
		</nav>
	</body>
</html>
