---
---
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<title>CMYK Brand Media Ltd - Streetwear Laboratory</title>
	</head>
	<!-- Set global background to deep navy/black to match the design -->
	<body class="bg-[#05070a] text-white font-sans antialiased pt-[72px] pb-[90px] overflow-x-hidden selection:bg-neutral-800">

		<!-- Fixed Solid Header -->
		<header class="fixed top-0 left-0 right-0 z-50 bg-[#05070a] flex items-center justify-between px-5 py-3 border-b border-white/5">
			<!-- Hamburger Menu -->
			<button aria-label="Menu" class="text-white">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
			</button>

			<!-- CMYK Logo Block -->
			<div class="flex flex-col items-center justify-center mt-1">
				<div class="flex space-x-0.5 mb-1 items-center justify-center relative w-8 h-4">
					<!-- Faux CMYK logo graphic -->
					<div class="absolute left-0 w-3 h-3 bg-[#00aeef] rounded-sm mix-blend-screen"></div>
					<div class="absolute left-2 w-3 h-3 bg-[#ec008c] rounded-sm mix-blend-screen"></div>
					<div class="absolute left-4 w-3 h-3 bg-[#fff200] rounded-sm mix-blend-screen"></div>
					<div class="absolute left-5 w-3 h-3 bg-[#231f20] border border-white/30 rounded-sm"></div>
				</div>
				<span class="text-[13px] font-black tracking-[0.15em] text-white leading-none mt-1">CMYK</span>
				<span class="text-[6px] tracking-[0.25em] text-neutral-400 uppercase mt-0.5 font-semibold">Brand Media Ltd</span>
			</div>

			<!-- Shopping Bag -->
			<div class="relative">
				<button aria-label="Cart" class="text-white">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
				</button>
				<span class="absolute -top-1 -right-1.5 bg-[#ef4444] text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center border-[1.5px] border-[#05070a]">1</span>
			</div>
		</header>

		<!-- Hero Section (Docked to header, heavily rounded bottom) -->
		<div class="relative w-full h-[320px] rounded-b-[2.5rem] overflow-hidden shadow-2xl shadow-black/50">
			<img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80" alt="Team" class="absolute inset-0 w-full h-full object-cover object-top" />
			<div class="absolute inset-0 bg-gradient-to-t from-[#05070a] via-[#05070a]/60 to-transparent"></div>

			<!-- Hero Content -->
			<div class="absolute bottom-10 inset-x-0 flex flex-col items-center px-4 space-y-4">
				<h1 class="text-[28px] font-black tracking-wide text-white drop-shadow-lg">'THE LAB IS OPEN.</h1>
				<a href="/custom-lab" class="px-6 py-2 bg-white/10 backdrop-blur-md border border-white/20 rounded-full text-[13px] font-medium text-white shadow-xl hover:bg-white/20 transition">
					Start Your Custom Build
				</a>
			</div>
		</div>

		<main class="max-w-md mx-auto px-4 pt-8 space-y-8">

			<!-- The Factory Floor -->
			<section class="space-y-4">
				<div class="flex items-center space-x-2 px-1">
					<h2 class="text-[15px] font-bold tracking-wide text-white uppercase">THE FACTORY FLOOR</h2>
					<span class="text-neutral-400 text-sm">⚙️</span>
				</div>

				<!-- Horizontal Scroll -->
				<div class="flex space-x-4 overflow-x-auto pb-4 scrollbar-none snap-x px-1">
					<!-- Card 1 -->
					<div class="min-w-[280px] snap-start bg-gradient-to-br from-[#1c2230] to-[#0f131c] border border-white/10 p-3.5 rounded-2xl flex items-center space-x-4 shadow-lg">
						<div class="w-[72px] h-[72px] bg-white rounded-[14px] flex-shrink-0 flex items-center justify-center p-1.5 shadow-inner">
							<img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=150&q=80" alt="DTF Machine" class="w-full h-full object-cover rounded-lg mix-blend-multiply" />
						</div>
						<div class="flex flex-col space-y-0.5">
							<h3 class="text-[15px] font-bold text-white tracking-wide">DTF Print <span class="text-[13px] font-normal text-neutral-400">(Machinery)</span></h3>
							<p class="text-[12px] text-neutral-500">Technical specs</p>
							<p class="text-[12px] text-neutral-500">Technical specs</p>
						</div>
					</div>

					<!-- Card 2 -->
					<div class="min-w-[280px] snap-start bg-gradient-to-br from-[#1c2230] to-[#0f131c] border border-white/10 p-3.5 rounded-2xl flex items-center space-x-4 shadow-lg">
						<div class="w-[72px] h-[72px] bg-white rounded-[14px] flex-shrink-0 flex items-center justify-center p-1.5 shadow-inner">
							<img src="https://images.unsplash.com/photo-1629739884942-8678d13805ce?auto=format&fit=crop&w=150&q=80" alt="UV Printer" class="w-full h-full object-cover rounded-lg mix-blend-multiply" />
						</div>
						<div class="flex flex-col space-y-0.5">
							<h3 class="text-[15px] font-bold text-white tracking-wide">UV Print <span class="text-[13px] font-normal text-neutral-400">(Item)</span></h3>
							<p class="text-[12px] text-neutral-500">Technical specs</p>
							<p class="text-[12px] text-neutral-500">Technical specs</p>
						</div>
					</div>
				</div>
			</section>

			<!-- The Drops -->
			<section class="space-y-4">
				<div class="flex items-center space-x-2 px-1">
					<h2 class="text-[15px] font-bold tracking-wide text-white uppercase">THE DROPS</h2>
					<span class="text-[11px] text-[#facc15] font-bold tracking-wider flex items-center bg-[#facc15]/10 px-2 py-0.5 rounded-full border border-[#facc15]/20">⭐ NEW</span>
				</div>

				<!-- Horizontal Scroll Grid -->
				<div class="flex space-x-4 overflow-x-auto pb-4 scrollbar-none snap-x px-1">
					
					<!-- Product 1 -->
					<div class="min-w-[155px] snap-start rounded-2xl overflow-hidden bg-[#0a0d14] border border-white/10 shadow-lg relative flex flex-col">
						<div class="h-[170px] bg-white p-2 relative flex items-center justify-center">
							<img src="https://images.unsplash.com/photo-1559551409-dadc959f76b8?auto=format&fit=crop&w=300&q=80" alt="Varsity Jacket" class="w-full h-full object-contain" />
							<span class="absolute bottom-2 right-2 bg-white/95 backdrop-blur-md px-2 py-1 rounded-md text-[11px] font-bold text-black border border-black/5 shadow-sm">$35.00</span>
						</div>
						<div class="bg-[#111622] p-3 flex-1 flex items-center">
							<h3 class="text-[13px] font-medium text-white tracking-wide">Varsity Jacket - B/W</h3>
						</div>
					</div>

					<!-- Product 2 -->
					<div class="min-w-[155px] snap-start rounded-2xl overflow-hidden bg-[#0a0d14] border border-white/10 shadow-lg relative flex flex-col">
						<div class="h-[170px] bg-[#e6e5e0] p-2 relative flex items-center justify-center">
							<img src="https://images.unsplash.com/photo-1591195853828-11db59a44f6b?auto=format&fit=crop&w=300&q=80" alt="Cargo Shorts" class="w-full h-full object-contain" />
							<span class="absolute bottom-2 right-2 bg-white/95 backdrop-blur-md px-2 py-1 rounded-md text-[11px] font-bold text-black border border-black/5 shadow-sm">$30.00</span>
						</div>
						<div class="bg-[#111622] p-3 flex-1 flex items-center">
							<h3 class="text-[13px] font-medium text-white tracking-wide">Cargo Shorts - Blk</h3>
						</div>
					</div>

					<!-- Product 3 -->
					<div class="min-w-[155px] snap-start rounded-2xl overflow-hidden bg-[#0a0d14] border border-white/10 shadow-lg relative flex flex-col">
						<div class="h-[170px] bg-cover bg-center p-2 relative flex items-center justify-center" style="background-image: url('https://images.unsplash.com/photo-1549490349-8643362247b5?auto=format&fit=crop&w=300&q=80');">
							<!-- Tracksuit mockup over vibrant background -->
							<img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=300&q=80" alt="Tracksuit" class="w-full h-full object-contain drop-shadow-2xl mix-blend-normal" />
							<span class="absolute bottom-2 right-2 bg-white/95 backdrop-blur-md px-2 py-1 rounded-md text-[11px] font-bold text-black border border-black/5 shadow-sm">$25.00</span>
						</div>
						<div class="bg-[#111622] p-3 flex-1 flex items-center">
							<h3 class="text-[13px] font-medium text-white tracking-wide">Tracksuit - Grey</h3>
						</div>
					</div>

				</div>
			</section>

		</main>

		<!-- Integrated Bottom Navigation & Footer -->
		<nav class="fixed bottom-0 left-0 right-0 bg-[#05070a]/95 backdrop-blur-2xl border-t border-white/10 pt-3 pb-3 px-6 z-50 flex flex-col items-center">
			<div class="max-w-md w-full mx-auto flex justify-between items-start mb-2.5">
				<a href="/" class="flex flex-col items-center space-y-1 text-white">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" /></svg>
					<span class="text-[11px] font-medium">Home</span>
				</a>
				<a href="/store" class="flex flex-col items-center space-y-1 text-neutral-500 hover:text-white transition">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
					<span class="text-[11px] font-medium">Store</span>
				</a>
				<a href="/custom-lab" class="flex flex-col items-center space-y-1 text-neutral-500 hover:text-white transition">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" /></svg>
					<span class="text-[11px] font-medium">Custom Lab</span>
				</a>
				<a href="/profile" class="flex flex-col items-center space-y-1 text-neutral-500 hover:text-white transition">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
					<span class="text-[11px] font-medium">Profile</span>
				</a>
			</div>
			<!-- Footer text embedded natively into bottom nav -->
			<span class="text-center text-[#52525a] text-[10px] tracking-wide w-full border-t border-white/5 pt-2">
				Abuja Streetwear Laboratory | (c) 2024
			</span>
		</nav>

	</body>
</html>
