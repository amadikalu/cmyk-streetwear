---
---
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>CMYK Brand Media Ltd - Streetwear Laboratory</title>
	</head>
	<body class="bg-[#0b0b0c] text-white font-sans antialiased pb-24">
		<header class="flex items-center justify-between px-6 py-4 border-b border-white/10 bg-[#0b0b0c]/80 backdrop-blur-md sticky top-0 z-50">
			<span class="text-xs font-bold tracking-widest text-cyan-400">CMYK</span>
			<span class="text-[10px] tracking-widest text-neutral-400 uppercase">Brand Media Ltd</span>
			<div class="relative"><span class="bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">1</span></div>
		</header>
		<main class="max-w-md mx-auto px-4 pt-4 space-y-8">
			<section class="rounded-2xl bg-neutral-900 border border-white/10 p-6 h-64 flex flex-col justify-end">
				<h1 class="text-3xl font-black tracking-tight">THE LAB IS OPEN.</h1>
				<a href="/custom-lab" class="mt-3 block text-center py-3 bg-white/10 border border-white/20 rounded-xl text-sm font-semibold">Start Your Custom Build</a>
			</section>
			<section class="space-y-3">
				<h2 class="text-sm font-bold tracking-wider text-neutral-300 uppercase">THE DROPS 🌟</h2>
				<div class="grid grid-cols-1 gap-4">
					<div class="bg-neutral-900 border border-white/10 rounded-2xl p-4">
						<h3 class="text-sm font-medium">Varsity Jacket - B/W</h3>
						<p class="text-xs text-neutral-400 mt-1">$35.00</p>
					</div>
				</div>
			</section>
		</main>
		<nav class="fixed bottom-0 left-0 right-0 bg-[#0b0b0c]/90 border-t border-white/10 py-3 px-6 z-50">
			<div class="max-w-md mx-auto flex justify-around text-xs">
				<a href="/" class="text-cyan-400 font-medium">Home</a>
				<a href="/store" class="text-neutral-400">Store</a>
				<a href="/custom-lab" class="text-neutral-400">Custom Lab</a>
				<a href="/profile" class="text-neutral-400">Profile</a>
			</div>
		</nav>
	</body>
</html>
