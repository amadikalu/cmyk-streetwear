---
---
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>CMYK Brand Media Ltd - Streetwear Laboratory</title>
	</head>
	<body class="bg-[#08080a] text-white font-sans antialiased pb-20 overflow-x-hidden selection:bg-neutral-800">

		<!-- Hero Section with Integrated Header -->
		<div class="relative w-full h-[400px] rounded-b-[2.5rem] overflow-hidden shadow-2xl">
			<!-- Background Image -->
			<img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80" alt="Team" class="absolute inset-0 w-full h-full object-cover" />
			<div class="absolute inset-0 bg-gradient-to-t from-[#08080a] via-black/40 to-black/60"></div>

			<!-- Transparent Header -->
			<header class="relative z-50 flex items-center justify-between px-6 py-4">
				<button aria-label="Menu" class="text-white">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
				</button>

				<!-- CMYK Logo -->
				<div class="flex flex-col items-center">
					<div class="flex space-x-0.5 mb-1">
						<div class="w-3 h-3 bg-cyan-400 rounded-sm"></div>
						<div class="w-3 h-3 bg-pink-500 rounded-sm"></div>
						<div class="w-3 h-3 bg-yellow-400 rounded-sm"></div>
						<div class="w-3 h-3 bg-black border border-white/20 rounded-sm"></div>
					</div>
					<span class="text-sm font-black tracking-widest text-white leading-none">CMYK</span>
					<span class="text-[8px] tracking-[0.2em] text-neutral-300 uppercase mt-0.5">Brand Media Ltd</span>
				</div>

				<!-- Cart -->
				<div class="relative">
					<button aria-label="Cart" class="text-white">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
					</button>
					<span class="absolute -top-1.5 -right-2 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-[#08080a]">1</span>
				</div>
			</header>

			<!-- Hero Content -->
			<div class="absolute bottom-10 inset-x-0 flex flex-col items-center px-4 space-y-4">
				<h1 class="text-3xl font-black tracking-wide text-white drop-shadow-lg">'THE LAB IS OPEN.</h1>
				<a href="/custom-lab" class="px-6 py-2.5 bg-white/10 backdrop-blur-md border border-white/20 rounded-full text-sm font-semibold text-white shadow-xl hover:bg-white/20 transition">
					Start Your Custom Build
				</a>
			</div>
		</div>

		<main class="max-w-md mx-auto px-4 pt-8 space-y-10">

			<!-- The Factory Floor -->
			<section class="space-y-4">
				<div class="flex items-center space-x-2 px-1">
					<h2 class="text-sm font-bold tracking-wider text-white uppercase">THE FACTORY FLOOR</h2>
					<span class="text-neutral-400">⚙️</span>
				</div>

				<!-- Horizontal Scroll -->
				<div class="flex space-x-4 overflow-x-auto pb-4 scrollbar-none snap-x px-1">
					<!-- Card 1 -->
					<div class="min-w-[260px] snap-start bg-gradient-to-br from-white/10 to-transparent border border-white/10 p-3 rounded-2xl flex items-center space-x-4 shadow-lg backdrop-blur-sm">
						<div class="w-20 h-20 bg-white rounded-xl flex-shrink-0 flex items-center justify-center overflow-hidden p-1">
							<img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=150&q=80" alt="DTF Machine" class="w-full h-full object-cover rounded-lg mix-blend-multiply" />
						</div>
						<div class="flex flex-col">
							<h3 class="text-sm font-bold text-white">DTF Print <span class="text-xs font-normal text-neutral-400">(Machinery)</span></h3>
							<p class="text-[11px] text-neutral-400 mt-1">Technical specs</p>
							<p class="text-[11px] text-neutral-400">Technical specs</p>
						</div>
					</div>

					<!-- Card 2 -->
					<div class="min-w-[260px] snap-start bg-gradient-to-br from-white/10 to-transparent border border-white/10 p-3 rounded-2xl flex items-center space-x-4 shadow-lg backdrop-blur-sm">
						<div class="w-20 h-20 bg-white rounded-xl flex-shrink-0 flex items-center justify-center overflow-hidden p-1">
							<img src="https://images.unsplash.com/photo-1629739884942-8678d13805ce?auto=format&fit=crop&w=150&q=80" alt="UV Printer" class="w-full h-full object-cover rounded-lg mix-blend-multiply" />
						</div>
						<div class="flex flex-col">
							<h3 class="text-sm font-bold text-white">UV Print <span class="text-xs font-normal text-neutral-400">(Item)</span></h3>
							<p class="text-[11px] text-neutral-400 mt-1">Technical specs</p>
							<p class="text-[11px] text-neutral-400">Technical specs</p>
						</div>
					</div>
				</div>
			</section>

			<!-- The Drops -->
			<section class="space-y-4">
				<div class="flex items-center space-x-2 px-1">
					<h2 class="text-sm font-bold tracking-wider text-white uppercase">THE DROPS</h2>
					<span class="text-xs text-amber-400 font-bold tracking-wider flex items-center">⭐ NEW</span>
				</div>

				<!-- Horizontal Scroll Grid -->
				<div class="flex space-x-4 overflow-x-auto pb-4 scrollbar-none snap-x px-1">
					
					<!-- Product 1 -->
					<div class="min-w-[170px] snap-start rounded-2xl overflow-hidden bg-neutral-900 border border-white/10 shadow-lg relative group">
						<div class="h-44 bg-white p-2 relative flex items-center justify-center">
							<img src="https://images.unsplash.com/photo-1559551409-dadc959f76b8?auto=format&fit=crop&w=300&q=80" alt="Varsity Jacket" class="w-full h-full object-contain drop-shadow-md" />
							<span class="absolute bottom-2 right-2 bg-neutral-100/90 backdrop-blur-sm px-2 py-0.5 rounded-md text-xs font-bold text-black border border-black/10">$35.00</span>
						</div>
						<div class="bg-[#121215] p-3 border-t border-white/5">
							<h3 class="text-[13px] font-medium text-white">Varsity Jacket - B/W</h3>
						</div>
					</div>

					<!-- Product 2 -->
					<div class="min-w-[170px] snap-start rounded-2xl overflow-hidden bg-neutral-900 border border-white/10 shadow-lg relative group">
						<div class="h-44 bg-[#e6e5e0] p-2 relative flex items-center justify-center">
							<img src="https://images.unsplash.com/photo-1591195853828-11db59a44f6b?auto=format&fit=crop&w=300&q=80" alt="Cargo Shorts" class="w-full h-full object-contain drop-shadow-md" />
							<span class="absolute bottom-2 right-2 bg-neutral-100/90 backdrop-blur-sm px-2 py-0.5 rounded-md text-xs font-bold text-black border border-black/10">$30.00</span>
						</div>
						<div class="bg-[#121215] p-3 border-t border-white/5">
							<h3 class="text-[13px] font-medium text-white">Cargo Shorts - Blk</h3>
						</div>
					</div>

					<!-- Product 3 -->
					<div class="min-w-[170px] snap-start rounded-2xl overflow-hidden bg-neutral-900 border border-white/10 shadow-lg relative group">
						<div class="h-44 bg-white p-2 relative flex items-center justify-center">
							<img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=300&q=80" alt="Tracksuit" class="w-full h-full object-contain drop-shadow-md" />
							<span class="absolute bottom-2 right-2 bg-neutral-100/90 backdrop-blur-sm px-2 py-0.5 rounded-md text-xs font-bold text-black border border-black/10">$25.00</span>
						</div>
						<div class="bg-[#121215] p-3 border-t border-white/5">
							<h3 class="text-[13px] font-medium text-white">Tracksuit - Grey</h3>
						</div>
					</div>

				</div>
			</section>

			<!-- Footer -->
			<footer class="text-center py-6 pb-8 text-[#52525a] text-[10px] tracking-wide">
				Abuja Streetwear Laboratory | (c) 2024
			</footer>

		</main>

		<!-- Bottom Navigation -->
		<nav class="fixed bottom-0 left-0 right-0 bg-[#08080a]/95 backdrop-blur-xl border-t border-white/10 pt-2 pb-5 px-6 z-50">
			<div class="max-w-md mx-auto flex justify-between items-center">
				<a href="/" class="flex flex-col items-center space-y-1 text-white">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" /></svg>
					<span class="text-[10px] font-medium">Home</span>
				</a>
				<a href="/store" class="flex flex-col items-center space-y-1 text-neutral-500 hover:text-white transition">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
					<span class="text-[10px] font-medium">Store</span>
				</a>
				<a href="/custom-lab" class="flex flex-col items-center space-y-1 text-neutral-500 hover:text-white transition">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" /></svg>
					<span class="text-[10px] font-medium">Custom Lab</span>
				</a>
				<a href="/profile" class="flex flex-col items-center space-y-1 text-neutral-500 hover:text-white transition">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
					<span class="text-[10px] font-medium">Profile</span>
				</a>
			</div>
		</nav>

	</body>
</html>
