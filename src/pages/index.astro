---
// Query D1 database at the Edge
const db = Astro.locals.runtime.env.DB;
const { results: products } = await db.prepare(
  "SELECT * FROM products"
).all();
---

<html lang="en" class="bg-gray-950 text-gray-100 font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CMYK | The Lab</title>
  </head>
  <body class="min-h-screen">
    <header class="p-4 border-b border-white/10 backdrop-blur-md bg-black/50 sticky top-0 z-50 flex justify-between items-center">
      <h1 class="text-xl font-black tracking-widest uppercase">CMYK <span class="text-cyan-400">LAB</span></h1>
      <div class="w-6 h-6 bg-yellow-400 rounded-full flex items-center justify-center text-black text-xs font-bold">0</div>
    </header>

    <main class="p-4 pb-20">
      <h2 class="text-lg font-bold tracking-widest uppercase mb-6 mt-4">The Drops</h2>

      <div class="grid grid-cols-2 gap-4">
        {products.map((item: any) => (
          <article class="rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md overflow-hidden shadow-2xl flex flex-col">
            <div class="aspect-square bg-gray-900 relative">
              <!-- CMYK overlay blend for unoptimized images -->
              <div class="absolute inset-0 bg-gradient-to-tr from-cyan-900/60 via-magenta-900/30 to-yellow-900/20 mix-blend-overlay"></div>
              
              <img 
                src={`/images/${item.r2_image_key}`} 
                alt={item.name} 
                loading="lazy" 
                class="object-cover h-full w-full mix-blend-luminosity hover:mix-blend-normal transition-all" 
              />
              
              {item.is_bespoke === 1 && (
                <span class="absolute top-2 left-2 bg-cyan-500 text-black text-[10px] font-black px-2 py-1 rounded-sm uppercase tracking-wider">
                  Custom Fit
                </span>
              )}
            </div>
            
            <div class="p-3 flex flex-col flex-grow justify-between border-t border-white/10">
              <h3 class="font-semibold text-gray-200 text-sm truncate">{item.name}</h3>
              <div class="mt-2 flex items-center justify-between">
                <span class="font-mono text-cyan-400 text-sm">₦{item.base_price.toLocaleString()}</span>
              </div>
              <a href={`/product/${item.id}`} class="mt-3 block text-center w-full bg-white/10 hover:bg-cyan-500 hover:text-black text-white text-xs font-bold py-2 rounded-lg transition-colors">
                Configure Fit
              </a>
            </div>
          </article>
        ))}
      </div>
    </main>
  </body>
</html>
