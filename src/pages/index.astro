---
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';

// Sample drops data matching urban streetwear specifications
const drops = [
  { id: 1, name: "Varsity Jacket - B/W", price: "$35.00", image: "https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&q=80&w=600" },
  { id: 2, name: "Cargo Shorts - Blk", price: "$30.00", image: "https://images.unsplash.com/photo-1562157873-818bc0726f68?auto=format&fit=crop&q=80&w=600" },
  { id: 3, name: "Tracksuit - Grey", price: "$25.00", image: "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&q=80&w=600" }
];

const machinery = [
  { title: "DTF Print (Machinery)", spec1: "High-Opacity CMYK Inks", spec2: "Direct Film Transfer" },
  { title: "UV Print (Item)", spec1: "Rigid Surface Coating", spec2: "Scratch-Resistant Finish" }
];
---

<html lang="en" class="bg-black text-gray-100 font-sans antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CMYK | Abuja Streetwear Laboratory</title>
  </head>
  <body class="min-h-screen pb-24 selection:bg-cyan-500 selection:text-black">
    <Header />

    <!-- Hero Banner Section -->
    <section class="relative bg-gradient-to-b from-gray-900 to-black py-12 px-4 border-b border-white/10 text-center overflow-hidden">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px]"></div>
      <div class="relative z-10 max-w-lg mx-auto">
        <h1 class="text-3xl font-black tracking-tighter uppercase mb-4 text-white">
          ‘THE LAB IS <span class="text-cyan-400">OPEN.</span>
        </h1>
        <a href="/custom-lab" class="inline-block px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-full text-xs font-bold uppercase tracking-widest backdrop-blur-md transition shadow-lg">
          Start Your Custom Build
        </a>
      </div>
    </section>

    <!-- Factory Floor Section -->
    <section class="py-6 px-4">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-sm font-black uppercase tracking-wider text-gray-300 flex items-center gap-2">
          THE FACTORY FLOOR ⚙
        </h2>
      </div>
      <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-none">
        {machinery.map((item) => (
          <div class="min-w-[220px] bg-gray-900/60 backdrop-blur-md border border-white/10 rounded-xl p-4 flex flex-col justify-between shadow-xl">
            <h3 class="font-bold text-xs uppercase text-white mb-2">{item.title}</h3>
            <p class="text-[11px] text-gray-400 font-mono">⚡ {item.spec1}</p>
            <p class="text-[11px] text-gray-400 font-mono mt-1">🔧 {item.spec2}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- The Drops Section -->
    <section class="py-4 px-4">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-sm font-black uppercase tracking-wider text-gray-300">
          THE DROPS <span class="text-yellow-400">★ NEW</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {drops.map((drop) => (
          <div class="bg-gray-900/80 border border-white/10 rounded-2xl overflow-hidden shadow-2xl backdrop-blur-md group">
            <div class="relative h-64 overflow-hidden bg-black">
              <img src={drop.image} alt={drop.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
              <div class="absolute top-3 right-3 bg-black/70 backdrop-blur-md border border-white/20 px-3 py-1 rounded-full text-xs font-black text-cyan-400 font-mono">
                {drop.price}
              </div>
            </div>
            <div class="p-4 flex justify-between items-center">
              <h3 class="font-bold text-sm tracking-wide text-white uppercase">{drop.name}</h3>
              <a href="/store" class="px-4 py-2 bg-white text-black text-xs font-black uppercase rounded-lg hover:bg-cyan-400 transition">
                Inspect
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="text-center py-8 text-[10px] text-gray-500 font-mono uppercase tracking-widest border-t border-white/5 mt-8">
      Abuja Streetwear Laboratory | (c) 2026
    </footer>

    <BottomNav />
  </body>
</html>
